<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inferencer</name>
  <version>0.0.0</version>
  <description>Inferencer plugins (TensorRT / TensorFlow) loaded at runtime by nn_controller</description>
  <maintainer email="zhongzheng@todo.todo">zhongzheng</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>
  <!-- CUDA, TensorRT and TensorFlow (pip) are system dependencies without rosdep keys -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
